<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal widget: one round button (colour = state) and, while connected, the traffic under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/widget_toggle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_button_off"
        android:contentDescription="@string/widget_toggle"
        android:padding="13dp"
        android:src="@drawable/ic_power" />

    <TextView
        android:id="@+id/widget_traffic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_label_bg"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:shadowColor="#80000000"
        android:shadowRadius="2"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
