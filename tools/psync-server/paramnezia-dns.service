[Unit]
Description=Authoritative DNS for the family VPN endpoint
Wants=network-online.target
After=network-online.target
[Service]
DynamicUser=yes
ExecStart=/opt/paramnezia-mirror/coredns -conf /opt/paramnezia-mirror/Corefile
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
Restart=on-failure
[Install]
WantedBy=multi-user.target
